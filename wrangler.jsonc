{
  "name": "running-sync-webhook",
  "main": "worker/worker.js",
  "compatibility_date": "2026-05-25",

  "vars": {
    "GITHUB_OWNER": "gacenko",
    "GITHUB_REPO": "running_sync"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}